# Public Supabase configuration — these VITE_ values are bundled for the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase configuration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI / AI runtime.
OPENAI_API_KEY=

# Legacy Lovable AI Gateway compatibility.
# Still required by the current AI Sales + Growth Engine code paths until phase 2.
LOVABLE_API_KEY=

# Growth / Make-facing API authentication.
NORYVA_GROWTH_API_SECRET=

# Agent cron compatibility. Current + previous secret are supported for rotation.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# IMPORTANT:
# Never expose SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY, LOVABLE_API_KEY,
# NORYVA_GROWTH_API_SECRET or cron secrets with a VITE_ prefix.
